{
  "name": "prosto-skills",
  "version": "0.0.0",
  "private": true,
  "description": "Composable, agent-authored skills for solving real problems.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "changeset": "changeset",
    "check": "npm run validate && npm run evaluate:validate && npm test && npm run smoke",
    "evaluate": "node scripts/evaluate.mjs",
    "evaluate:validate": "node scripts/evaluate.mjs --validate-only",
    "install:codex": "INSTALL_INTERNAL_SKILLS=1 skills add . -g -a codex -s '*'",
    "release:tag": "changeset tag",
    "smoke": "node scripts/smoke-install.mjs",
    "test": "node --test",
    "validate": "node scripts/validate.mjs",
    "version": "changeset version"
  },
  "dependencies": {
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.2",
    "skills": "1.5.23"
  }
}
